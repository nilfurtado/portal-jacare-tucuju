# ============================================================
# Painel DM — Apache rewrite
# Compatível com Hostinger Web Hosting (Apache + mod_rewrite)
# ============================================================

Options -Indexes
AddDefaultCharset UTF-8

# Bloqueia acesso direto a .env e arquivos sensíveis
<FilesMatch "^\.(env|env\.example|gitignore|deployignore|htaccess)$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(sql|md|log|bak)$">
  Require all denied
</FilesMatch>

RewriteEngine On

# Bloqueia acesso DIRETO a arquivos PHP dentro de lib/ e storage/
# (sem barrar URLs /api/* que precisam chegar no front-controller)
RewriteRule ^lib/.*\.php$       - [F,L]
RewriteRule ^storage/.*$        - [F,L]

# 1) URLs /api/* sempre vão pro front-controller index.php
RewriteRule ^api/.*$ index.php [L,QSA]

# 2) Arquivos estáticos existentes em public/ — serve direto
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} !-f
RewriteCond public/%{REQUEST_URI} -f
RewriteRule ^(.*)$ public/$1 [L]

# 3) Tudo o que sobrou vai pro index.php (servir login.html como fallback)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# Cache para assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript   "access plus 7 days"
  ExpiresByType image/svg+xml            "access plus 30 days"
  ExpiresByType image/png                "access plus 30 days"
  ExpiresByType image/jpeg               "access plus 30 days"
  ExpiresByType image/webp               "access plus 30 days"
  ExpiresByType application/json         "access plus 0 seconds"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
