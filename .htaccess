# ============================================================
# Portal Jacaré Tucujú — raiz
# Força charset UTF-8 em todos os assets para evitar caracteres
# corrompidos (Voc� em vez de Você) no navegador.
# ============================================================

AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  # Sobrescreve Content-Type incluindo charset
  AddType "application/json; charset=utf-8"        .json
  AddType "text/html; charset=utf-8"               .html .htm
  AddType "text/css; charset=utf-8"                .css
  AddType "application/javascript; charset=utf-8"  .js
  AddType "image/svg+xml; charset=utf-8"           .svg
  AddType "text/plain; charset=utf-8"              .txt
  AddType "application/xml; charset=utf-8"         .xml

  # Para versões antigas do Apache
  AddCharset utf-8 .json .html .htm .css .js .svg .txt .xml
</IfModule>

# Cabeçalhos extras pra ter certeza absoluta
<IfModule mod_headers.c>
  <FilesMatch "\.(json|html|css|js|svg)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

# Cache para assets estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                 "access plus 7 days"
  ExpiresByType application/javascript   "access plus 7 days"
  ExpiresByType image/svg+xml            "access plus 30 days"
  ExpiresByType image/png                "access plus 30 days"
  ExpiresByType image/jpeg               "access plus 30 days"
  ExpiresByType image/webp               "access plus 30 days"
  ExpiresByType application/json         "access plus 0 seconds"
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>

# Compressão GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# Página de erro customizada
ErrorDocument 404 /404.html

# Bloqueia acesso a arquivos sensíveis
<FilesMatch "^\.(env|env\.example|gitignore|deployignore|htaccess|gitattributes)$">
  Require all denied
</FilesMatch>
